{
	"name": "delightful-finances",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy url cookie baseLocale --emit-ts-declarations",
		"dev": "vite dev",
		"precheck": "pnpm paraglide",
		"prebuild": "pnpm paraglide",
		"pretest:unit": "pnpm paraglide",
		"pretest:e2e": "pnpm paraglide",
		"build": "vite build",
		"deploy:jazz": "jazz-tools deploy --schema-dir src/lib --migrations-dir src/lib/migrations",
		"preview": "vite preview",
		"prepare": "pnpm paraglide && FINANCE_PREVIEW=true svelte-kit sync",
		"check": "FINANCE_PREVIEW=true svelte-kit sync && FINANCE_PREVIEW=true svelte-check --tsconfig ./tsconfig.json && tsc --project src/service-worker/tsconfig.json --noEmit",
		"check:watch": "FINANCE_PREVIEW=true svelte-kit sync && FINANCE_PREVIEW=true svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:unit": "vitest",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:pwa": "playwright test --config playwright.pwa.config.ts",
		"test:auth": "playwright test --config playwright.auth.config.ts",
		"test:permissions": "playwright test --config playwright.permissions.config.ts",
		"test:workspace": "playwright test --config playwright.workspace.config.ts",
		"check:tests": "tsc --project tests/tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@poppanator/sveltekit-svg": "^7.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@xstate/svelte": "^5.0.0",
		"delightful-ui": "file:vendor/delightful-ui-0.0.24.tgz",
		"jazz-tools": "2.0.0-alpha.59",
		"pica": "^10.0.3",
		"tdesign-icons-svg": "^0.4.7",
		"xstate": "^5.33.2",
		"zod": "4.1.11"
	}
}
