{
	"name": "delightful-finances",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie baseLocale --emit-ts-declarations",
		"dev": "vite dev",
		"dev:network": "vite dev --host 0.0.0.0",
		"dev:agent": "vite dev --config vite.e2e.config.ts --port 5180",
		"precheck": "pnpm paraglide",
		"prebuild": "pnpm paraglide",
		"pretest:unit": "pnpm paraglide",
		"pretest:e2e": "pnpm paraglide",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "pnpm paraglide && FINANCE_PREVIEW=true svelte-kit sync",
		"check": "FINANCE_PREVIEW=true svelte-kit sync && FINANCE_PREVIEW=true svelte-check --tsconfig ./tsconfig.json && tsc --project src/service-worker/tsconfig.json --noEmit",
		"check:watch": "FINANCE_PREVIEW=true svelte-kit sync && FINANCE_PREVIEW=true svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test:unit": "vitest",
		"test:worker-state": "pnpm --filter @delightful-finances/worker-state-tests test",
		"test:worker-host": "vitest run --config vitest.worker-host.config.ts",
		"test": "pnpm test:unit --run && pnpm test:e2e",
		"test:e2e": "playwright test",
		"test:pwa": "playwright test --config tests/config/playwright.pwa.config.ts",
		"test:auth": "playwright test --config tests/config/playwright.auth.config.ts",
		"test:permissions": "playwright test --config tests/config/playwright.permissions.config.ts",
		"test:workspace": "playwright test --config tests/config/playwright.workspace.config.ts",
		"check:tests": "tsc --project tests/tsconfig.json --noEmit",
		"test:attachments": "playwright test --config tests/config/playwright.transaction-attachments.config.ts",
		"test:description": "playwright test --config tests/config/playwright.transaction-description.config.ts",
		"test:startup": "playwright test --config tests/config/playwright.startup.config.ts",
		"test:fake-data": "playwright test --config tests/config/playwright.fake-data.config.ts",
		"check:e2e": "node --experimental-strip-types scripts/check-e2e-scopes.ts"
	},
	"devDependencies": {
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.60.0",
		"@poppanator/sveltekit-svg": "^7.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-vercel": "7.0.2",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^26.6.5",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@faker-js/faker": "^10.6.0",
		"@opentelemetry/api": "^1.9.1",
		"@vercel/functions": "3.11.0",
		"@vercel/sandbox": "3.9.1",
		"@xstate/svelte": "6.0.0-beta.0",
		"delightful-local-first": "file:vendor/delightful-local-first-dbc452e-xstate-v6-jazz-alpha60.tgz",
		"delightful-ui": "file:vendor/delightful-ui-7a7f61b-xstate-v6.tgz",
		"jazz-tools": "2.0.0-alpha.60",
		"layerchart": "^2.9.0",
		"pica": "^10.0.3",
		"tdesign-icons-svg": "^0.4.7",
		"ws": "8.22.1",
		"xstate": "6.0.0-beta.1",
		"zod": "4.1.11"
	},
	"engines": {
		"node": "24.x"
	},
	"packageManager": "pnpm@10.22.0"
}
